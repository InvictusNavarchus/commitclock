{
  "name": "commitclock",
  "version": "0.1.0",
  "private": true,
  "description": "Daily and hourly GitHub commit analytics",
  "type": "module",
  "bin": {
    "commitclock": "src/cli.ts"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "bun fmt",
    "build": "bun build --compile src/cli.ts --outfile dist/commitclock"
  },
  "dependencies": {
    "cac": "7.1.0",
    "dayjs": "1.11.23",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
